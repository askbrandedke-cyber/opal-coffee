# ─────────────────────────────────────────────────────────────
#  Opal Coffee — environment variables (copy to .env.local)
#  No real secrets belong in this file.
# ─────────────────────────────────────────────────────────────

# Public URL of the live site — used for canonical URLs, sitemap and social previews.
# (On Vercel this falls back to the production domain automatically.)
NEXT_PUBLIC_SITE_URL=https://opal-coffee.vercel.app

# WhatsApp business number, international format, digits only (e.g. 2547XXXXXXXX).
# When set, the menu shows "+" buttons and a WhatsApp request builder.
# Leave empty to hide WhatsApp everywhere.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Google Maps Embed API key. Without it, a keyless Google embed is used.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Contact form delivery via Resend (https://resend.com). Server-side only.
# Without all three, the form tells visitors honestly that messages can't be sent yet.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Design preview only — shows labelled placeholders for missing reviews / venue photos.
# NEVER enable on the public site.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
